# Database (Supabase PostgreSQL connection string for production)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/faceroom

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-key
SUPABASE_BUCKET=event-photos

# Qdrant Cloud
QDRANT_URL=https://your-cluster.qdrant.io
QDRANT_API_KEY=your-qdrant-api-key
QDRANT_COLLECTION=face_embeddings

# Redis (Upstash for production)
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET=change-this-to-a-long-random-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://your-app.vercel.app

# Face processing
FACE_SIMILARITY_THRESHOLD=0.5
DBSCAN_EPS=0.45
DBSCAN_MIN_SAMPLES=2

# Frontend (for Vercel)
VITE_API_URL=https://your-backend.onrender.com/api/v1
